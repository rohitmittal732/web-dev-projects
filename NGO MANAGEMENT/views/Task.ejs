<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style3.css">
    <title>Tasks</title>
</head>
<body>
    <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
         <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        
        <i class="material-icons">logout</i>
        </div>
    </nav>
   <div class="section">

    <div class="head">
        <div>
            <h2>Assigned Tasks</h2>
            <p>View, edit and manage all assigned volunteer tasks.</p>
        </div>

        <a href="/task/new" class="btn btn-primary" style="padding:10px 20px;color:white">
            Assign Task
        </a>
    </div>

    <div class="table-responsive mt-4">

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-primary">
                <tr>
                    <th>Volunteer</th>
                    <th>Task</th>
                    <th>Location</th>
                    <th>Deadline</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <% tasks.forEach((task)=>{ %>

                <tr>

                    <td><%= task.volunteer.fullname %></td>

                    <td><%= task.title %></td>

                    <td><%= task.location || "N/A" %></td>

                   <td>
                        <%= task.deadline ? task.deadline.toLocaleDateString("en-IN") : "No deadline" %>
                    </td>


                    <td>

                        <% if(task.status==="Pending"){ %>

                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>

                        <% } else if(task.status==="In Progress"){ %>

                            <span class="badge bg-primary">
                                In Progress
                            </span>

                        <% } else { %>

                            <span class="badge bg-success">
                                Completed
                            </span>

                        <% } %>

                    </td>

                    <td>

                        <a href="/task/edit/<%=task._id%>"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <form action="/task/delete/<%=task._id%>?_method=DELETE"
                              method="POST"
                              class="d-inline">

                            <button class="btn btn-danger btn-sm">
                                Delete
                            </button>

                        </form>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <% if(tasks.length===0){ %>

        <div class="alert alert-info mt-3">
            No Tasks Assigned Yet.
        </div>

    <% } %>

</div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>