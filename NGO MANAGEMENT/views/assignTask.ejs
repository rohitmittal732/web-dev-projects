<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Assign Tasks</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style2.css">
</head>
<body>
 <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
        <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        <input type="text" placeholder="Search" class="input">
       
        <i class="material-icons">logout</i>
        </div>
    </nav>

  <div class="container py-5">

    <div class="donor-form">

        <div class="mb-4">
            <h2 class="page-title">Assign Task</h2>
            <p class="page-text">
                Fill in the details below to assign a new task to a volunteer.
            </p>
        </div>

        <form action="/task/new" method="POST">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Volunteer</label>
                    <select class="form-select" name="volunteer" required>

                        <option value="">Select Volunteer</option>

                        <% volunteers.forEach(volunteer=>{ %>

                            <option value="<%= volunteer._id %>">
                                <%= volunteer.fullname %>
                            </option>

                        <% }) %>

                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Task Title</label>
                    <input
                        type="text"
                        class="form-control"
                        name="title"
                        placeholder="Food Distribution"
                        required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Location</label>
                    <input
                        type="text"
                        class="form-control"
                        name="location"
                        placeholder="Jaipur"
                        required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Deadline</label>
                    <input
                        type="date"
                        class="form-control"
                        name="deadline"
                        required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Priority</label>
                    <select class="form-select" name="priority">

                        <option>Low</option>
                        <option>Medium</option>
                        <option>High</option>

                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">

                        <option>Pending</option>
                        <option>In Progress</option>
                        <option>Completed</option>

                    </select>
                </div>
                 
                <div class="col-md-6 mb-3">
                <label class="form-label">Campaign</label>
                <select class="form-select" name="campaign">

                    <option>Select Campaign</option>

                    <% campaigns.forEach(campaign=>{ %>
                        <option value="<%= campaign._id %>">
                            <%= campaign.title %>
                        </option>
                    <% }) %>

                </select>
            </div>


                <div class="col-12 mb-4">
                    <label class="form-label">Task Description</label>

                    <textarea
                        class="form-control"
                        rows="4"
                        name="description"
                        placeholder="Write task details..."></textarea>
                </div>

            </div>

            <div class="d-flex gap-3">

                <button type="submit" class="btn btn-primary px-4">
                    Assign Task
                </button>

                <a href="/tasks" class="btn btn-outline-secondary px-4">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

