<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="./style3.css">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>Document</title>
</head>
<body>
    <nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/donorDashboard">Dashboard</a>
        <a href="/myDonations">Donations</a>
        <a href="/myCampaigns">Campaigns</a>
        <a href="/donorProfile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/'">logout</i>
    </div>
</nav>
    <div class="container py-5">

    <div class="donor-form">

        <div class="mb-4">
            <h2 class="page-title">My Profile</h2>
            <p class="page-text">
                View your personal information.
            </p>
        </div>

        <div class="text-center mb-4">

            <img
            src="https://as1.ftcdn.net/v2/jpg/05/31/61/02/1000_F_531610226_Q9ZhO5KQFGa3Bo7a9vDbQU8lZ4LzPs8l.jpg"
            class="rounded-circle"
            width="120"
            height="120">

        </div>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label class="form-label">Full Name</label>
                <input
                class="form-control"
                value="<%= user.fullname %>"
                disabled>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Email</label>
                <input
                class="form-control"
                value="<%= user.email %>"
                disabled>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Phone</label>
                <input
                class="form-control"
                value="<%= user.phone %>"
                disabled>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Role</label>
                <input
                class="form-control"
                value="<%= user.role %>"
                disabled>
            </div>

        </div>

        <a
        href="/donor/profile/edit/<%= user._id %>"
        class="btn btn-primary mt-3">
            Edit Profile
        </a>

    </div>

</div>
</body>
</html>