<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="./style3.css">

  
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <title>Helping Hands NGO</title>
</head>

<body>
    <nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/volunteerDashboard">Dashboard</a>
        <a href="/mytasks">My Tasks</a>
        <a href="/volunteerEvents">Events</a>
        <a href="/profile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/'">logout</i>
    </div>
</nav>



<div class="container-fluid py-4">

    <div class="head mb-4">
        <div>
            <h2>Donor Dashboard</h2>
            <p>Track your donations, supported campaigns and profile.</p>
        </div>
    </div>



    <div class="row g-4 mb-5">

        <div class="col-lg-3 col-md-6">
            <div class="base">
                <div class="fit1">
                    <span class="material-icons">volunteer_activism</span>
                </div>

                <div class="cont">
                    <small>Total Donations</small>
                    <h3>1,230</h3>
                </div>
            </div>
        </div>


        <div class="col-lg-3 col-md-6">
            <div class="base">
                <div class="fit2">
                    <span class="material-icons">payments</span>
                </div>

                <div class="cont">
                    <small>Total Amount</small>
                    <h3>$2,000</h3>
                </div>
            </div>
        </div>


        <div class="col-lg-3 col-md-6">
            <div class="base">
                <div class="fit3">
                    <span class="material-icons">campaign</span>
                </div>

                <div class="cont">
                    <small>Campaigns</small>
                    <h3>12</h3>
                </div>
            </div>
        </div>


        <div class="col-lg-3 col-md-6">
            <div class="base">
                <div class="fit4">
                    <span class="material-icons">workspace_premium</span>
                </div>

                <div class="cont">
                    <small>Certificates</small>
                    <h3>3</h3>
                </div>
            </div>
        </div>

    </div>




    <div class="row g-4">

        <div class="col-lg-8">

            <div class="donation-card w-100">

                <div class="card-header">
                    <h3 class="card-title">Recent Donations</h3>
                </div>

                <% if(donations.length>0){ %>

                <table class="table table-bordered table-hover">

                    <thead>

                        <tr>
                            <th>Campaign</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% donations.slice(0,4).forEach(donation=>{ %>

                        <tr>

                            <td><%= donation.campaign %></td>

                            <td>₹<%= donation.amount %></td>

                            <td>
                                <%= donation.createdAt.toLocaleDateString("en-IN") %>
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    Successful
                                </span>
                            </td>

                        </tr>

                        <% }) %>

                    </tbody>

                </table>

                <% } else { %>

                <div class="alert alert-info m-3">
                    No Donations Found.
                </div>

                <% } %>

            </div>

        </div>




        <div class="col-lg-4">

            <div class="vlr w-100">

                <h3 class="mb-4">Donor Profile</h3>

                <div class="line">

                    <img class="avatar"
                    src="https://i.pravatar.cc/100?img=18">

                    <div class="profile">

                        <strong><%= user.fullname %></strong>

                        <small>Donor</small>

                    </div>

                </div>

                <hr>

                <p>
                    <strong>Email :</strong>
                    <%= user.email %>
                </p>

                <p>
                    <strong>Phone :</strong>
                    <%= user.phone %>
                </p>

                <p>
                    <strong>Total Donations :</strong>
                    <%= donations.length %>
                </p>

                <p>
                    <strong>Member Since :</strong>
                    <%= user.createdAt.toLocaleDateString("en-IN") %>
                </p>

                <a href="/donorProfile"
                   class="btn btn-primary w-100 mt-3">

                    Edit Profile

                </a>

            </div>

        </div>

    </div>





    <div class="head mt-5 mb-4">

        <div>

            <h2>Supported Campaigns</h2>

            <p>Campaigns you have supported with your donations.</p>

        </div>

    </div>




    <% if(campaigns.length>0){ %>

    <div class="setting">

        <% campaigns.forEach(campaign=>{ %>

        <div class="card" style="width:30rem;">

            <img src="<%= campaign.image %>"
                 class="card-img-top"
                 style="height:220px;object-fit:cover;">

            <div class="card-body">

                <h4 class="card-title mb-3">
                    <%= campaign.title %>
                </h4>

                <div class="bg-light rounded p-3 border">

                    <div class="d-flex align-items-center mb-3">

                        <span class="material-icons text-primary me-2">
                            flag
                        </span>

                        <span>
                            Goal ₹<%= campaign.goal %>
                        </span>

                    </div>

                    <div class="d-flex align-items-center mb-4">

                        <span class="material-icons text-success me-2">
                            payments
                        </span>

                        <span>
                            Raised ₹<%= campaign.collected %>
                        </span>

                    </div>

                    <a href="/campaign/<%= campaign._id %>"
                       class="btn btn-primary w-100">

                        Donate Again

                    </a>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

    <% } else { %>

    <div class="alert alert-info">

        No Campaigns Supported Yet.

    </div>

    <% } %>

</div>
</body>
</html>