<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Campaigns</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style3.css">
</head>
<body>

<nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/donorDashboard">Dashboard</a>
        <a href="/mydonations">My Donations</a>
        <a href="/mycampaigns">My Campaigns</a>
        <a href="/profile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/logout'">logout</i>
    </div>
</nav>

<div class="section">

    <div class="head">

        <div>
            <h2>My Campaigns</h2>
            <p>Campaigns you have contributed to.</p>
        </div>

        <a href="/"
           class="btn btn-primary"
           style="padding:10px 20px;color:white;">
            Browse Campaigns
        </a>

    </div>

    <% if(campaigns.length > 0){ %>

    <div class="row mt-4 g-4">

        <% campaigns.forEach(campaign=>{ %>

        <div class="col-lg-4 col-md-6">

            <div class="card h-100 shadow-sm">

                <img src="<%= campaign.image %>"
                     class="card-img-top"
                     style="height:220px;object-fit:cover;">

                <div class="card-body d-flex flex-column">

                    <h4 class="card-title">
                        <%= campaign.title %>
                    </h4>

                    <p class="card-text">
                        <%= campaign.description %>
                    </p>

                    <div class="mt-auto">

                        <div class="mb-2">
                            <strong>Goal:</strong>
                            ₹<%= campaign.goal %>
                        </div>

                        <div class="mb-3">
                            <strong>Raised:</strong>
                            ₹<%= campaign.collected %>
                        </div>

                        <div class="progress mb-3" style="height:10px;">

                           <div class="progress">
                                <div class="progress-bar bg-primary"
                                    role="progressbar"
                                    style="--progress: <%= ((campaign.collected / campaign.goal) * 100).toFixed(2) %>;"
                                    aria-valuenow="<%= campaign.collected %>"
                                    aria-valuemin="0"
                                    aria-valuemax="<%= campaign.goal %>">
                                    <%= campaign.collected %> / <%= campaign.goal %>
                                </div>
                                </div>

                        </div>

                        <a href="/campaign/<%= campaign._id %>"
                           class="btn btn-primary w-100">
                            View Campaign
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

    <% } else { %>

    <div class="alert alert-info mt-4">

        <h5 class="mb-2">
            No Campaigns Found
        </h5>

        <p class="mb-3">
            You haven't donated to any campaign yet.
        </p>

        <a href="/" class="btn btn-primary">
            Explore Campaigns
        </a>

    </div>

    <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>