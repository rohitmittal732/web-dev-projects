<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Registration</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style3.css">
</head>
<body>

<nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/volunteerDashboard">Dashboard</a>
        <a href="/mytasks">My Tasks</a>
        <a href="/events">Events</a>
        <a href="/profile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/logout'">logout</i>
    </div>
</nav>

<div class="container py-5">

    <div class="form-box text-center">

        <div class="mb-4">
            <span class="material-icons"
                  style="font-size:90px;color:#198754;">
                check_circle
            </span>
        </div>

        <h2 class="page-title mb-3">
            Registration Successful
        </h2>

        <p class="page-text">
            You have successfully registered for
            <strong><%= event.title %></strong>.
        </p>

        <hr class="my-4">

        <div class="row text-start">

            <div class="col-md-6 mb-3">
                <strong>Event</strong>
                <p><%= event.title %></p>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Date</strong>
                <p><%= event.date.toLocaleDateString("en-IN") %></p>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Location</strong>
                <p><%= event.location %></p>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Status</strong>
                <p class="text-success fw-bold">
                    Registered
                </p>
            </div>

        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">

            <a href="/events"
               class="btn btn-outline-secondary px-4">
                Back to Events
            </a>

            <a href="/volunteerDashboard"
               class="btn btn-primary px-4">
                Go to Dashboard
            </a>

        </div>

    </div>

</div>

</body>
</html>