<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Campaign</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style2.css">
</head>
<body>
 <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
        <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        <input type="text" placeholder="Search" class="input">
       
        <i class="material-icons">logout</i>
        </div>
    </nav>

  <div class="container py-5">

    <div class="form-box">

        <div class="mb-4">
            <h2 class="page-title">Add Campaign</h2>
            <p class="page-text">
                Fill in the campaign details to create a new fundraising campaign.
            </p>
        </div>

        <form action="/campaign" method="POST">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign Title</label>
                    <input class="form-control" type="text" name="title" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Goal Amount</label>
                    <input class="form-control" type="number" name="goal" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Collected Amount</label>
                    <input class="form-control" type="number" name="collected" placeholder="0">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign Category</label>
                    <select class="form-select" name="category" required>
                        <option>Select Category</option>
                        <option>Education</option>
                        <option>Healthcare</option>
                        <option>Food Donation</option>
                        <option>Environment</option>
                        <option>Women Empowerment</option>
                        <option>Child Welfare</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign Status</label>
                    <select class="form-select" name="status" required>
                        <option>Active</option>
                        <option>Completed</option>
                        <option>Upcoming</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign Image</label>
                    <input class="form-control" type="text" name="image" placeholder="Paste image URL">
                </div>

                <div class="col-12 mb-4">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" rows="4" name="description" placeholder="Write a short description about this campaign..."></textarea>
                </div>

            </div>

            <div class="d-flex gap-3">

                <button class="btn btn-primary px-4" type="submit">
                    Save Campaign
                </button>

                <a href="/campaigns" class="btn btn-outline-secondary px-4">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
