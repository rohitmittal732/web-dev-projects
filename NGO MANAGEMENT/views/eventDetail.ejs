
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Details</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style3.css">
</head>
<body>

<nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/volunteerDashboard">Dashboard</a>
        <a href="/mytasks">My Tasks</a>
        <a href="/volunteerEvents">Events</a>
        <a href="/profile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/logout'">logout</i>
    </div>
</nav>

<div class="container py-5">

    <div class="form-box">

        <img src="<%= event.image %>"
             class="img-fluid rounded mb-4"
             style="width:100%;height:400px;object-fit:cover;">

        <h2 class="page-title">
            <%= event.title %>
        </h2>

        <p class="page-text">
            <%= event.description %>
        </p>

        <hr>

        <div class="row mt-4">

            <div class="col-md-6 mb-4">

                <h5>Date</h5>
                <p>
                <%= event.date ? event.date.toLocaleDateString("en-IN") : "N/A" %>
                </p>


            </div>

            <div class="col-md-6 mb-4">

                <h5>Location</h5>
                <p>
                    <%= event.location %>
                </p>

            </div>

            <div class="col-md-6 mb-4">

                <h5>Organizer</h5>
                <p>
                    Helping Hands NGO
                </p>

            </div>

            <div class="col-md-6 mb-4">

                <h5>Category</h5>
                <p>
                    <%= event.category %>
                </p>

            </div>

        </div>

        <div class="alert alert-primary">

            <strong>Instructions</strong>

            <ul class="mt-3 mb-0">
                <li>Reach the venue 30 minutes before the event.</li>
                <li>Carry your Volunteer ID Card.</li>
                <li>Follow instructions given by the Event Coordinator.</li>
                <li>Wear comfortable clothes and shoes.</li>
            </ul>

        </div>

        <div class="d-flex gap-3 mt-4">

            <a href="/events"
               class="btn btn-outline-secondary px-4">
                Back
            </a>

            <a href="/event/register/<%= event._id %>"
               class="btn btn-primary px-4">
                Register
            </a>

        </div>

    </div>

</div>


</body>
</html>