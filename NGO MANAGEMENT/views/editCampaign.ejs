<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Campaign</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style2.css">
</head>
<body>
  <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
        <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        <input type="text" placeholder="Search" class="input">
       
        <i class="material-icons">logout</i>
        </div>
    </nav>

  <div class="container py-5">

    <div class="form-box">

        <div class="mb-4">
            <h2 class="page-title">Edit Campaign</h2>
            <p class="page-text">
                Update the campaign details and save your changes.
            </p>
        </div>

        <form action="/campaign/edit/<%= campaign.id %>?_method=PUT" method="POST">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign Title</label>
                    <input class="form-control" type="text" name="title" value="<%= campaign.title %>" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Goal Amount</label>
                    <input class="form-control" type="number" name="goal" value="<%= campaign.goal %>" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Collected Amount</label>
                    <input class="form-control" type="number" name="collected" value="<%= campaign.collected %>">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign Category</label>
                    <select class="form-select" name="category" required>
                        <option <%= campaign.category==="Education" ? "selected" : "" %>>Education</option>
                        <option <%= campaign.category==="Healthcare" ? "selected" : "" %>>Healthcare</option>
                        <option <%= campaign.category==="Food Donation" ? "selected" : "" %>>Food Donation</option>
                        <option <%= campaign.category==="Environment" ? "selected" : "" %>>Environment</option>
                        <option <%= campaign.category==="Women Empowerment" ? "selected" : "" %>>Women Empowerment</option>
                        <option <%= campaign.category==="Child Welfare" ? "selected" : "" %>>Child Welfare</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign Status</label>
                    <select class="form-select" name="status" required>
                        <option value="Active" <%= campaign.status==="Active" ? "selected" : "" %>>Active</option>
                        <option value="Completed" <%= campaign.status==="Completed" ? "selected" : "" %>>Completed</option>
                        <option value="Upcoming" <%= campaign.status==="Upcoming" ? "selected" : "" %>>Upcoming</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign Image</label>
                    <input class="form-control" type="text" name="image" value="<%= campaign.image %>">
                </div>

                <div class="col-12 mb-4">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" rows="4" name="description"><%= campaign.description %></textarea>
                </div>

            </div>

            <div class="d-flex gap-3">

                <button class="btn btn-primary px-4" type="submit">
                    Update Campaign
                </button>

                <a href="/campaigns" class="btn btn-outline-secondary px-4">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
