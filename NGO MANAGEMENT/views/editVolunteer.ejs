<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Volunteer</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style2.css">
</head>
<body>
  <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
        <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        <input type="text" placeholder="Search" class="input">
       
        <i class="material-icons">logout</i>
        </div>
    </nav>

  <div class="container py-5">

    <div class="form-box">

        <div class="mb-4">
            <h2 class="page-title">Edit Volunteer</h2>
            <p class="page-text">
                Update the volunteer details and save your changes.
            </p>
        </div>

        <form action="/volunteer/edit/<%= volunteer.id %>?_method=PUT" method="POST">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Full Name</label>
                    <input class="form-control" type="text" name="fullName" value="<%= volunteer.fullname %>" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" name="email" value="<%= volunteer.email %>" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone Number</label>
                    <input class="form-control" type="text" name="phone" value="<%= volunteer.phone %>" pattern="[0-9]{10}" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Age</label>
                    <input class="form-control" type="number" name="age" value="<%= volunteer.age %>" min="16" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Gender</label>
                    <select class="form-select" name="gender" required>
                        <option value="Male" <%= volunteer.gender==="Male" ? "selected" : "" %>>Male</option>
                        <option value="Female" <%= volunteer.gender==="Female" ? "selected" : "" %>>Female</option>
                        <option value="Non-binary" <%= volunteer.gender==="Non-binary" ? "selected" : "" %>>Non-binary</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">City</label>
                    <input class="form-control" type="text" name="city" value="<%= volunteer.city %>" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Primary Skill</label>
                    <select class="form-select" name="skill" required>
                        <option value="Teaching & Mentoring" <%= volunteer.skill==="Teaching & Mentoring" ? "selected" : "" %>>Teaching & Mentoring</option>
                        <option value="Healthcare & Nursing" <%= volunteer.skill==="Healthcare & Nursing" ? "selected" : "" %>>Healthcare & Nursing</option>
                        <option value="Social Media & Marketing" <%= volunteer.skill==="Social Media & Marketing" ? "selected" : "" %>>Social Media & Marketing</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Availability</label>
                    <select class="form-select" name="availability" required>
                        <option value="Weekdays (Morning)" <%= volunteer.availability==="Weekdays (Morning)" ? "selected" : "" %>>Weekdays (Morning)</option>
                        <option value="Weekdays (Evening)" <%= volunteer.availability==="Weekdays (Evening)" ? "selected" : "" %>>Weekdays (Evening)</option>
                        <option value="Weekends Only" <%= volunteer.availability==="Weekends Only" ? "selected" : "" %>>Weekends Only</option>
                        <option value="Remote" <%= volunteer.availability==="Remote" ? "selected" : "" %>>Remote</option>
                    </select>
                </div>

                <div class="col-12 mb-4">
                    <label class="form-label">Motivation</label>
                    <textarea class="form-control" rows="4" name="motivation"><%= volunteer.motivation %></textarea>
                </div>

            </div>

            <div class="d-flex gap-3">

                <button class="btn btn-primary px-4" type="submit">
                    Update Volunteer
                </button>

                <a href="/volunteers" class="btn btn-outline-secondary px-4">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>