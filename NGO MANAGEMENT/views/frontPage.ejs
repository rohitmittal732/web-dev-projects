<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style1.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <title>Document</title>
</head>
<div>
    <nav>
        <div class="set">
            <div class="fit"><img src="https://thumbs.dreamstime.com/b/print-288782922.jpg"></div>
        <h2>Helping Hands NGO</h2></div>
        <div class="pass"><a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">Campaigns</a>
        <a href="#">Events</a>
        <a href="#">Contacts</a></div>

        <div class="end"><button class="btn1" onclick="window.location.href='/login/form'">Login</button>
        <button class="btn2" onclick="window.location.href='/donate/form'">Donate Now</button></div>
    </nav>

    <div class="main">
        <div class="content">
            <h1>Together We Can Make a <br> Difference</h1>
            <p>Helping Hands NGO is dedicated to improving
            lives through <br>community-driven initiatives in education, healthcare, and<br> sustainable
             development. Join us in our journey to create a<br> better world
              for everyone.</p>
        </div>
        <div class="frame">
            <img src="./assets/help.png">
        </div>
    </div>
    <div class="btns">
        <button class="btn3" onclick="window.location.href='/volunteer/form'">Become Volunteer</button>
        <button class="btn4" onclick="window.location.href='/donate/form'">Donate Now</button>
    </div>
    <div class="about">
        <div class="heading">
             <h1>Our Core Mission</h1>
        <p>We believe in empowering communities through strategic intervention. Our focus is on <br> long-term sustainability rather than just immediate relief.</p>
        </div>
        <div class="section">
            <div class="ed">
                <div class="blue">
                    <span class="material-symbols-outlined " >school</span></div>
                <h1>Education Support</h1>
                <p>Providing scholarships, school supplies, and <br> vocational training to children and young adults from <br>underserved backgrounds.</p>
            </div>
            <div class="hp">
                <div class="blue">
                    <span class="material-symbols-outlined " >medical_services</span></div>
                
                <h1>HealthCare Programs</h1>
                <p>Running mobile clinics, health awareness camps, and <br> supporting local hospitals with medical equipment<br> and expertise.</p>
            </div>
            <div class="cp">
                <div class="blue">
                    <span class="material-symbols-outlined " >groups</span></div>
                
                <h1>Community Development</h1>
                <p>Initiating sustainable agriculture projects, clean water<br> access, and infrastructure development within local<br> neighborhoods.</p>

    
            </div>
        </div>
    </div>
    <div class="campaigns">
        <h2>Active Campaigns</h2>
        <div class="view">
            <p>Join our current initiatives and track our progress towards making a lasting impact.</p>
            <div class="all">
                <a href="#">
                    View All Campaigns 
                </a>
            
                <span class="material-icons">arrow_forward</span>
            </div>
            </div>
            <div class="cards">
                <% campaigns.forEach(campaign=>{ %>

               
                <div class="card" style="width: 30rem;">
  <img src="<%= campaign.image %>" class="card-img-top" alt="Education">
  <div class="card-body">
    <h4 class="card-title"><%=campaign.title %></h4>
     <p class="card-text"><%=campaign.description %></p>
    
    <div class="btn5">
        <a href="donate/form" class="btn btn-primary">Donate Now</a>
    </div>
  </div>
</div>
<% }) %>

</div>
       
    </div>

 
<div class="stats-banner py-5">
  <div class="container">
    <div class="row text-center text-white">
      
      <div class="col-md-3 mb-3">
        <h2>15L+</h2>
        <p>Fund Raised</p>
      </div>
     
      <div class="col-md-3 mb-3">
        <h2>500+</h2>
        <p>Donors</p>
      </div>
     
      <div class="col-md-3 mb-3">
        <h2>120+</h2>
        <p>Campaigns</p>
      </div>
      
      <div class="col-md-3 mb-3">
        <h2>300+</h2>
        <p>Volunteers</p>
      </div>
    </div>
  </div>
</div>

<div class="events">
    <div class="heading">
             <h1>Upcoming Events</h1>
        <p>Participate in our upcoming community gatherings and help us spread our <br> message.</p>
        </div>
    
        <div class="register">
            <% events.forEach(event=>{ %>
            <div class="register-card">
            <div class="date">
                <span class="material-icons">calendar_today</span>
                <h5> <%= event.date %> </h5>
            </div>
            <h3><%=event.title %></h3>
            <div class="city">
                <span class="material-icons">location_on</span>
                <p> <%= event.location %> </p>
            </div>
            <button>Register</button>
            </div>
          <% }) %>
            </div>
