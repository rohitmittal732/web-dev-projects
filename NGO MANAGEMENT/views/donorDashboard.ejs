<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./style3.css">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <title>Helping Hands NGO</title>
    <title>Document</title>
</head>
<body>
    <nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/donorDashboard">Dashboard</a>
        <a href="/myDonations">Donations</a>
        <a href="/myCampaigns">Campaigns</a>
        <a href="/donorProfile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/'">logout</i>
    </div>
</nav>

<div class="cards">

    <div class="card">
        <h3>TOTAL DONATIONS</h3>
        <h1>1,302</h1>
    </div>

    <div class="card">
        <h3>TOTAL AMOUNT</h3>
        <h1>$1</h1>
    </div>

    <div class="card">
        <h3>CAMPAIGNS SUPPORTED</h3>
        <h1><%= campaigns.length %></h1>
    </div>

    <div class="card">
        <h3>MEMBER SINCE</h3>
        <h1><%= user.createdAt.getFullYear() %></h1>
    </div>

</div>


<div class="bottom">

    <!-- Recent Donations -->

    <div class="donation-card">

        <div class="card-header">
            <h3 class="card-title">Recent Donations</h3>
        </div>

        <% if(donations.length>0){ %>

        <table class="table table-bordered table-hover">

            <thead class="table-primary">

                <tr>
                    <th>Campaign</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>

            </thead>

            <tbody>

                <% donations.slice(0,4).forEach(donation=>{ %>

                <tr>

                    <td><%= donation.campaign %></td>

                    <td>₹<%= donation.amount %></td>

                    <td>
                        <%= donation.createdAt.toLocaleDateString("en-IN") %>
                    </td>

                    <td>
                        <span class="badge bg-success">
                            Successful
                        </span>
                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

        <% } else { %>

        <div class="alert alert-info m-3">
            You haven't made any donations yet.
        </div>

        <% } %>

    </div>


    <!-- Profile -->

    <div class="vlr">

        <h3>My Profile</h3>

        <div class="line">

            <img
            class="avatar"
            src="https://i.pravatar.cc/100?img=18">

            <div class="profile">

                <strong><%= user.fullname %></strong>

                <small>Donor</small>

            </div>

        </div>

        <hr>

        <p>
            <strong>Email:</strong>
            <%= user.email %>
        </p>

        <p>
            <strong>Phone:</strong>
            <%= user.phone %>
        </p>

        <p>
            <strong>Total Donations:</strong>
            <%= donations.length %>
        </p>

        <p>
            <strong>Member Since:</strong>
            <%= user.createdAt.toLocaleDateString("en-IN") %>
        </p>

        <a href="/donor/profile"
           class="btn btn-primary w-100">
            Edit Profile
        </a>

    </div>

</div>



<div class="head mt-5">

    <div>

        <h2>
            Supported Campaigns
        </h2>

        <p>
            Campaigns you have contributed to.
        </p>

    </div>

    <a href="/myCampaigns"
       class="btn btn-primary"
       style="padding:10px 20px;color:white">

        View All

    </a>

</div>


<% if(campaigns.length>0){ %>

<div class="setting">

    <% campaigns.slice(0,3).forEach(campaign=>{ %>

    <div class="card" style="width:30rem;height:35rem;">

        <img
        src="<%= campaign.image %>"
        class="card-img-top"
        style="height:15rem;object-fit:cover;">

        <div class="card-body">

            <h4 class="card-title">
                <%= campaign.title %>
            </h4>

            <p class="card-text">
                <%= campaign.description.substring(0,90) %>...
            </p>

            <div class="register-card">

                <div class="date">

                    <span class="material-icons">
                        volunteer_activism
                    </span>

                    <h5>
                        Goal ₹<%= campaign.goal %>
                    </h5>

                </div>

                <div class="city">

                    <span class="material-icons">
                        payments
                    </span>

                    <p>
                        Raised ₹<%= campaign.collected %>
                    </p>

                </div>

                <a href="/campaign/<%= campaign._id %>"
                   class="btn btn-primary w-100">

                    Donate Again

                </a>

            </div>

        </div>

    </div>

    <% }) %>

</div>

<% } else { %>

<div class="alert alert-info mt-4">

    No supported campaigns yet.

</div>

<% } %>

</body>
</html>