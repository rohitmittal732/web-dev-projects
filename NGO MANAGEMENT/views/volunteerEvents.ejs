<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
     <link rel="stylesheet" href="/style3.css">
    <title>Events</title>
</head>
<body>
     <nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/volunteerDashboard">Dashboard</a>
        <a href="/mytasks">My Tasks</a>
        <a href="/volunteerEvents">Events</a>
        <a href="/profile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/'">logout</i>
    </div>
</nav>
<div class="container py-5">

    <div class="head mb-4">

        <div>
            <h2 class="page-title">Upcoming Events</h2>
            <p class="page-text">
                Participate in NGO events and contribute to the community.
            </p>
        </div>

    </div>

    <div class="row g-4">

        <% events.forEach(event=>{ %>

        <div class="col-lg-4 col-md-6">

            <div class="card h-100 shadow-sm border-0 rounded-4">

                <img src="<%= event.image %>"
                     class="card-img-top"
                     style="height:220px; object-fit:cover;">

                <div class="card-body">

                    <h4 class="card-title mb-3">
                        <%= event.title %>
                    </h4>

                    <p class="card-text text-muted">
                        <%= event.description %>
                    </p>

                    <hr>

                    <div class="mb-2">
                        <strong>Date</strong><br>
                        <span>
                            <%= event.date.toLocaleDateString("en-IN") %>
                        </span>
                    </div>

                    <div class="mb-2">
                        <strong>Time</strong><br>
                        <span>
                            <%= event.time %>
                        </span>
                    </div>

                    <div class="mb-3">
                        <strong>Location</strong><br>
                        <span>
                            <%= event.location %>
                        </span>
                    </div>

                    <div class="d-grid gap-2">

                        <a href="/event/<%= event._id %>"
                           class="btn btn-outline-primary">

                            View Details

                        </a>

                        <form action="/event/join/<%= event._id %>"
                              method="POST">

                            <button class="btn btn-primary w-100">

                                Join Event

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

    <% if(events.length===0){ %>

        <div class="alert alert-info mt-4">

            No Upcoming Events Available.

        </div>

    <% } %>

</div>
</body>
</html>