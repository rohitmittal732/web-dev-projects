<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Campaigns</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style2.css">
</head>
<body>
  <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
        <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        <input type="text" placeholder="Search" class="input">
       
        <i class="material-icons">logout</i>
        </div>
    </nav>

  <div class="section">

    <div class="head">

        <div>
            <h2>Manage Campaigns</h2>
            <p>View and manage all active fundraising campaigns.</p>
        </div>

        <a href="/campaign/new" class="btn btn-primary">
            Add Campaign
        </a>

    </div>

    <div class="table-responsive mt-4">

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-primary">

                <tr>
                    <th>Image</th>
                    <th>Campaign</th>
                    <th>Goal Amount</th>
                    <th>Collected</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                <% campaigns.forEach((campaign)=>{ %>

                <tr>

                    <td>
                        <img
                            src="<%= campaign.image || 'https://placehold.co/70x70?text=NGO' %>"
                            class="campaign-img"
                            alt="Campaign">
                    </td>

                    <td>
                        <%= campaign.title ?? "N/A" %>
                    </td>

                    <td>
                        ₹ <%= campaign.goal ?? "N/A" %>
                    </td>

                    <td>
                        ₹ <%= campaign.collected ?? "0" %>
                    </td>

                    <td>
                        <%= campaign.description ?? "N/A" %>
                    </td>

                    <td>

                        <a
                            href="/campaign/edit/<%= campaign._id %>"
                            class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <form
                            action="/campaign/delete/<%= campaign._id %>?_method=DELETE"
                            method="POST"
                            class="d-inline">

                            <button
                                class="btn btn-sm btn-danger">
                                Delete
                            </button>

                        </form>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <% if(campaigns.length===0){ %>

        <div class="alert alert-info mt-4">
            No Campaigns Found.
        </div>

    <% } %>

</div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

