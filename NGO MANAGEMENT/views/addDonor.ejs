<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Donor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style2.css">
</head>
<body>
 <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
        <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        <input type="text" placeholder="Search" class="input">
       
        <i class="material-icons">logout</i>
        </div>
    </nav>

  <div class="container py-5">

    <div class="donor-form">

        <div class="mb-4">
            <h2 class="page-title">Add Donor</h2>
            <p class="page-text">
                Fill in the donor details to register a new donor.
            </p>
        </div>

        <form action="/donor" method="POST">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Full Name</label>
                    <input
                        type="text"
                        class="form-control"
                        name="name"
                        placeholder="John Doe"
                        required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input
                        type="email"
                        class="form-control"
                        name="email"
                        placeholder="name@gmail.com"
                        required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone Number</label>
                    <input
                        type="tel"
                        class="form-control"
                        name="phone"
                        placeholder="9876543210"
                        pattern="[0-9]{10}"
                        required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Campaign</label>
                    <select class="form-select" name="campaign" required>
                        <option value="">Select Campaign</option>
                        <option>Education Support</option>
                        <option>Food Distribution</option>
                        <option>Healthcare Support</option>
                        <option>Tree Plantation</option>
                        <option>Women Empowerment</option>
                    </select>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label">Donation Amount (₹)</label>
                    <input
                        type="number"
                        class="form-control"
                        name="amount"
                        placeholder="5000"
                        min="1"
                        required>
                </div>

            </div>

            <div class="d-flex gap-3 mt-2">

                <button type="submit" class="btn btn-primary px-4">
                    Save Donor
                </button>

                <a href="/donors" class="btn btn-outline-secondary px-4">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

