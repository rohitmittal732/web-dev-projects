  <div class="arm"><h1>Become a Volunteer</h1>
  <p>
        Join our global community of change-makers. Your time and skills can make a <br>profound impact on the lives of children and families in need. Let's build a<br> brighter future together.
            </p></div>
     <div class="base">
        <div class="form-card ">
       
        <form action="/volunteer/form" method="POST">
  <div class="flat">
    <div class="mb-3">
    <label  class="form-label" >Full Name</label>
    <input type="text" class="form-control" placeholder="John Doe" name="fullname" required>
  </div>
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label" required>Email</label>
    <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" name="email" placeholder="name@gmail.com" required>
  </div>
  </div>
  <div class="flat">
     <div class="mb-3">
    <label  class="form-label">Phone Number</label>
    <input type="tel" class="form-control" placeholder="123-456-7890" pattern="[0-9]{10}" name="phone" required>
  </div>
  <div class="mb-3">
  <label  class="form-label">Age</label>
    <input type="text" class="form-control" name="age" placeholder="25" required>
</div>
  </div>

  <div class="flat">
    <div class="mb-3">
  <label  class="form-label">Gender</label>
    <select class="form-select" name="gender" id="gender">
    <option value="">Select Gender</option>
    <option value="Male">Male</option>
    <option value="Female">Female</option>
    <option value="Non-binary">Non-binary</option>
   
  </select>
</div>
<div class="mb-3">
  <label  class="form-label">City</label>
    <input type="text" class="form-control" placeholder="New York" name="city" required>
</div>
</div>
<div class="flat">
  <div class="mb-3">
  <label  class="form-label">Skills</label>
    <select class="form-select" id="skills" name="skill">
    <option value="">Select Primary Skill</option>
    <option value="Teaching & Mentoring">Teaching & Mentoring</option>
    <option value="Healthcare & Nursing">Healthcare & Nursing</option>
    <option value="Social Media & Marketing">Social Media & Marketing</option>
    </select>
</div>

<div class="mb-3">
  <label  class="form-label">Availability</label>
    <select class="form-select" id="availability" name="availability">
    <option value="">When can you help</option>
    <option value="Weekdays(Morning)">Weekdays(Morning)</option>
    <option value="Weekdays(Evening)">Weekdays(Evening)</option>
    <option value="Weekends only">Weekends only</option>
    <option value="Remote">Remote</option>
    </select>
</div>

  </div>
  <div class="mb-3">
    <label  class="form-label" >Why do you want to Volunteer</label>
    <textarea  class="form-control" placeholder="Share your motivation with us..."  name="motivation"></textarea>
  </div>
   

  <button type="submit" class="btn btn-primary" id="btn6">Register</button>
  
</form>


    </div>
         <div class="myContent">
        <div class="hero">
  <img 
