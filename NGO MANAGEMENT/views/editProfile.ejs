<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
     <link rel="stylesheet" href="/style3.css">
    <title>Edit Profile</title>
</head>
<body>
     <nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/volunteerDashboard">Dashboard</a>
        <a href="/mytasks">My Tasks</a>
        <a href="/volunteerEvents">Events</a>
        <a href="/profile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/'">logout</i>
    </div>
</nav>
<div class="container py-5">

    <div class="donor-form">

        <div class="mb-4">
            <h2 class="page-title">My Profile</h2>
            <p class="page-text">
                Update your personal information and volunteer details.
            </p>
        </div>

        <div class="row">

           
            <div class="col-lg-4 mb-4">

                <div class="text-center border rounded-4 p-4 h-100">

                    <img src="<%= volunteer.image || 'https://i.pravatar.cc/150?img=12' %>"
                         class="rounded-circle mb-3"
                         width="120"
                         height="120"
                         style="object-fit:cover;">

                    <h4><%= volunteer.fullname %></h4>

                    <span class="badge bg-primary px-3 py-2">
                        Volunteer
                    </span>

                    <hr>

                    <p><strong>Email</strong></p>
                    <p class="text-muted"><%= volunteer.email %></p>

                    <p><strong>Phone</strong></p>
                    <p class="text-muted"><%= volunteer.phone %></p>

                    <p><strong>City</strong></p>
                    <p class="text-muted"><%= volunteer.city %></p>

                </div>

            </div>


           

            <div class="col-lg-8">

                <form action="/profile/update/<%= volunteer._id %>?_method=PUT"
                      method="POST">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name</label>

                            <input
                            type="text"
                            class="form-control"
                            name="fullname"
                            value="<%= volunteer.fullname %>">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>

                            <input
                            type="email"
                            class="form-control"
                            name="email"
                            value="<%= volunteer.email %>">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone</label>

                            <input
                            type="text"
                            class="form-control"
                            name="phone"
                            value="<%= volunteer.phone %>">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">City</label>

                            <input
                            type="text"
                            class="form-control"
                            name="city"
                            value="<%= volunteer.city %>">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Skill</label>

                            <input
                            type="text"
                            class="form-control"
                            name="skill"
                            value="<%= volunteer.skill %>">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Availability</label>

                            <select class="form-select"
                                    name="availability">

                                <option
                                <%= volunteer.availability==="Weekdays"?"selected":"" %>>
                                Weekdays
                                </option>

                                <option
                                <%= volunteer.availability==="Weekends"?"selected":"" %>>
                                Weekends
                                </option>

                                <option
                                <%= volunteer.availability==="Anytime"?"selected":"" %>>
                                Anytime
                                </option>

                            </select>

                        </div>

                        <div class="col-12 mb-4">

                            <label class="form-label">
                                Motivation
                            </label>

                            <textarea
                            class="form-control"
                            rows="4"
                            name="motivation"><%= volunteer.motivation %></textarea>

                        </div>

                    </div>

                    <div class="d-flex gap-3">

                        <button
                        class="btn btn-primary px-4"
                        type="submit">

                            Save Changes

                        </button>

                        <a href="/volunteerDashboard"
                           class="btn btn-outline-secondary px-4">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
</body>
</html>