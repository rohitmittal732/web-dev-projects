<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
     <link rel="stylesheet" href="/style3.css">
    <title>Document</title>
</head>
<body>
     <nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/volunteerDashboard">Dashboard</a>
        <a href="/mytasks">My Tasks</a>
        <a href="/events">Events</a>
        <a href="/profile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/'">logout</i>
    </div>
</nav>
<div class="container py-5">

    <div class="head mb-4">
        <div>
            <h2 class="page-title">My Tasks</h2>
            <p class="page-text">
                View your assigned tasks and update your progress.
            </p>
        </div>
    </div>

    <% if(tasks.length === 0){ %>

        <div class="alert alert-info text-center py-4">
            <h5 class="mb-2">No Tasks Assigned</h5>
            <p class="mb-0">
                You don't have any assigned tasks yet. Please wait until the admin assigns one.
            </p>
        </div>

    <% } else { %>

    <div class="row g-4">

        <% tasks.forEach(task=>{ %>

        <div class="col-lg-6">

            <div class="task-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <h4 class="mb-2"><%= task.title %></h4>
                        <p class="text-muted mb-3"><%= task.description %></p>
                    </div>

                    <% if(task.priority==="High"){ %>
                        <span class="badge bg-danger">High</span>
                    <% } else if(task.priority==="Medium"){ %>
                        <span class="badge bg-warning text-dark">Medium</span>
                    <% } else { %>
                        <span class="badge bg-success">Low</span>
                    <% } %>

                </div>

                <hr>

                <div class="row">

                    <div class="col-6 mb-3">
                        <strong>Campaign</strong>
                        <p><%= task.campaign ? task.campaign.title : "N/A" %></p>
                    </div>

                    <div class="col-6 mb-3">
                        <strong>Location</strong>
                        <p><%= task.location %></p>
                    </div>

                    <div class="col-6">
                        <strong>Deadline</strong>
                        <p>
                            <%= task.dueDate ? task.dueDate.toLocaleDateString("en-IN") : "N/A" %>
                        </p>
                    </div>

                    <div class="col-6">
                        <strong>Current Status</strong>

                        <% if(task.status==="Pending"){ %>
                            <p class="text-warning fw-bold">Pending</p>
                        <% } else if(task.status==="In Progress"){ %>
                            <p class="text-primary fw-bold">In Progress</p>
                        <% } else { %>
                            <p class="text-success fw-bold">Completed</p>
                        <% } %>

                    </div>

                </div>

                <form action="/mytask/status/<%= task._id %>?_method=PUT"
                      method="POST"
                      class="mt-4">

                    <label class="form-label">Update Status</label>

                    <select name="status" class="form-select mb-3">

                        <option value="Pending"
                        <%= task.status==="Pending"?"selected":"" %>>
                            Pending
                        </option>

                        <option value="In Progress"
                        <%= task.status==="In Progress"?"selected":"" %>>
                            In Progress
                        </option>

                        <option value="Completed"
                        <%= task.status==="Completed"?"selected":"" %>>
                            Completed
                        </option>

                    </select>

                    <button class="btn btn-primary w-100">
                        Update Task
                    </button>

                </form>

            </div>

        </div>

        <% }) %>

    </div>

    <% } %>

</div>
</div>
</body>
</html>