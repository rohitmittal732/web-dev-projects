<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Campaign</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style2.css">
</head>
<body>
  <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
        <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        <input type="text" placeholder="Search" class="input">
       
        <i class="material-icons">logout</i>
        </div>
    </nav>

  <div class="container py-5">

    <div class="form-box">

        <div class="mb-4">
            <h2 class="page-title">Edit Campaign</h2>
            <p class="page-text">
                Update the campaign details and save your changes.
            </p>
        </div>

        <form action="/event/edit/<%= event._id %>?_method=PUT" method="POST">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Title</label>
                    <input class="form-control" type="text" name="title" value="<%= event.title %>" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Date</label>
                    <input class="form-control" type="date" name="date" value="<%= event.date ? event.date.toISOString().split('T')[0] : '' %>" required>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Location</label>
                    <input class="form-control" type="text" name="location" value="<%= event.location %>">
                </div>

                

                <div class="col-md-6 mb-3">
                    <label class="form-label">Event Image</label>
                    <input class="form-control" type="text" name="image" value="<%= event.image %>" >
                </div>

                

            </div>

            <div class="d-flex gap-3">

                <button class="btn btn-primary px-4" type="submit">
                    Update Campaign
                </button>

                <a href="/events" class="btn btn-outline-secondary px-4">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
