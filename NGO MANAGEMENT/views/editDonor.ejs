<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Donor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">NGO Management</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/volunteers">Volunteers</a></li>
          <li class="nav-item"><a class="nav-link" href="/donors">Donors</a></li>
          <li class="nav-item"><a class="nav-link" href="/campaigns">Campaigns</a></li>
          <li class="nav-item"><a class="nav-link" href="/donations">Donations</a></li>
          <li class="nav-item"><a class="nav-link" href="/reports">Reports</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <h2>Edit Donor</h2>

    <form class="card p-4 shadow-sm" action="/donor/edit/<%= donor.id %>?_method=PUT" method="POST">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Name</label>
          <input class="form-control" type="text" name="name" value="<%= donor.name %>" required>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Phone</label>
          <input class="form-control" type="text" name="phone" value="<%= donor.phone %>" required>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Amount</label>
          <input class="form-control" type="number" step="0.01" name="amount" value="<%= donor.amount %>" required>
        </div>
      </div>

      <button class="btn btn-primary" type="submit">Update</button>
      <a class="btn btn-secondary ms-2" href="/donors">Cancel</a>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

