<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Events</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style2.css">
</head>
<body>
    <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
         <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        
        <i class="material-icons">logout</i>
        </div>
    </nav>
    <div class="section">

    <div class="head">

        <div>
            <h2>Manage Events</h2>
            <p>View and manage all upcoming NGO events.</p>
        </div>

        <a href="/event/new" class="btn btn-primary">
            Add Event
        </a>

    </div>

    <div class="table-responsive mt-4">

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-primary">

                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                <% events.forEach((event)=>{ %>

                <tr>
                    <td>
                        <img
                            src="<%= event.image || 'https://placehold.co/70x70?text=NGO' %>"
                            class="campaign-img"
                            alt="Event">
                    </td>

                    <td><%= event.title ?? "N/A" %></td>

                    <td><%= event.date ?? "N/A" %></td>

                    <td><%= event.location ?? "N/A" %></td>

                    <td>

                        <a
                            href="/event/edit/<%= event._id %>"
                            class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <form
                            action="/event/delete/<%= event._id %>?_method=DELETE"
                            method="POST"
                            class="d-inline">

                            <button
                                type="submit"
                                class="btn btn-sm btn-danger">
                                Delete
                            </button>

                        </form>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <% if(events.length===0){ %>

        <div class="alert alert-info mt-4">
            No Events Found.
        </div>

    <% } %>

</div>
</body>
</html>