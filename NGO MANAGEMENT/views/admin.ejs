<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="style2.css"> 
    <title>Document</title>
</head>
<body>
    <nav class="Navbar">
        <h2>Helping Hands NGO</h2>
       <div class="pass">
        <a href="/admin">Dashboard</a>
         <a href="/donors">Donors</a>
        <a href="/volunteers">Volunteers</a>
        <a href="/campaigns">Campaigns</a>
        <a href="/events">Events</a>
       </div>
        <div class="end">
        <input type="text" placeholder="Search" class="input">
        <i class="material-icons">notifications_none</i>
        <i class="material-icons">account_circle</i>
        <i class="material-icons" onclick="window.location.href='/'" style="cursor:pointer">logout</i>
        </div>
    </nav>
    <div class="section">
        <div class="heading">
            <h2>Welcome Back,Admin.</h2>
            <p>Manage campaigns, volunteers, donors and events from one place. Your <br>
                oversight ensures we reach more lives every day.</p>
        </div>
        <div class="cols">
            <div class="base">
                <div class="fit1">
                    <i class="material-symbols-outlined">volunteer_activism</i> </div>
                    <div class="cont"><p>Total Donations</p>
                    <h1>$124,500</h1></div>
                </div>
           
            <div class="base">
                <div class="fit2">
                    <i class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">group</i> </div>                  
                   <div class="cont">
                     <p>Total Donors</p>
                    <h1>1,240</h1>
                   </div>
                </div>
           
            <div class="base">
                <div class="fit3">
                    <i class="material-symbols-outlined">person_pin_circle</i></div>
                   <div class="cont"> <p>Active Volunteers</p>
                    <h1>456</h1></div>
                </div>
            <div class="base">
                <div class="fit4">
                    <i class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">campaign</i>    </div>                
                   <div class="cont"> <p>Total Campaigns</p>
                    <h1>12</h1></div>
                </div>
            
        </div>
        <div class="btns">
            <a href="/campaigns" class="btn btn-primary">Add Campaign</a>
            <a href="/events" class="btn btn-primary">Add Event</a>
            <a href="/tasks" class="btn btn-primary">Assign Tasks</a>
            <a href="/volunteers" class="btn btn-light white">View Volunteers</a>
            <a href="/reports" class="btn btn-light white">View Reports</a>
  </div>
  <div class="flat">
    
    
  <div class="donation-card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h2 class="card-title">Recent Donations</h2>
      <button class="btn btn-link text-primary">View All</button>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Donor Name</th>
            <th>Campaign</th>
            <th>Amount</th>
            <th>Phone</th>
          </tr>
        </thead>
        <tbody>
          <% donations.forEach(donation=>{ %>
          <tr>
            <td><strong><%= donation.donorName %></strong></td>
            <td><%= donation.campaign %></td>
            <td class="text-primary fw-bold">$<%= donation.amount %></td>
            <td><%= donation.phone %></td>
          </tr>
       <% }) %>
        </tbody>
      </table>
    </div>
 
  </div>
  <div class="vlr">
    <h3>Volunteer Requests</h3>
    <% volunteers.forEach(volunteer=>{ %>
   <div class="pfCard">
     <div class="line">
      <div class="kb">
         <% if(volunteer.gender==="Female"){ %>
        <img src="https://tse1.explicit.bing.net/th/id/OIP.BB_HK0lnPuXYhmkfSyYU7AHaHa?r=0&rs=1&pid=ImgDetMain&o=7&rm=3" alt='volunteer' class="avatar">
        <% } else{ %>
        <img src="https://cdn.pixabay.com/photo/2024/11/10/12/33/businessman-9187780_1280.jpg" alt='volunteer' class="avatar">         
        <% } %>
    </div>
    <div class="profile">
      <h4><%= volunteer.fullname %></h4>
      <p><%= volunteer.skill %></p>
    </div>
    </div>
    <div class="bottom">
      <a href="volunteer/approve/<%= volunteer._id %>" class="btn btn-primary">Approve</a>
      <a href="volunteer/reject/<%= volunteer._id %>" class="btn btn-light white">Reject</a>
    </div>
  </div>
<% }) %>
   </div>
  </div>  
  <div class="head">
   <h2>Upcoming Events</h2>
   <a href="#">View all</a>
  </div> 
  <div class="setting">
    <% events.forEach(event=>{ %>
    <div class="card" style="width: 30rem; height:35rem">
  <img src="<%= event.image %>" class="card-img-top" style="height: 15rem; " alt="Education">
  <div class="card-body">
    <h4 class="card-title"><%= event.title %> </h4>
   <div class="register-card">
            <div class="date">
                <span class="material-icons">calendar_today</span>
                <h5><%= event.date %></h5>
            </div>
            
            <div class="city">
                <span class="material-icons">location_on</span>
                <p><%= event.location %></p>
            </div>
            <button>Manage Event</button>
  </div>
</div>
    </div>
 <% }) %>
  </div>
</body>
</html>