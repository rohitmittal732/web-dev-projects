<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/style1.css">
</head>
<body>
    <nav class="top-navbar">
        <h2> Helping Hands NGO</h2>
       <div class="items">
         <a href="#">Home</a>
        <a href="#">Campaigns</a>
        <a href="#">About</a>
        <button onclick="window.location.href='/donate/form'">Donate Now</button>
       </div>
    </nav>
    <div class="base">
        <div>
         <div class="form-card">
        <h1>Join Helping Hands NGO</h1>
        <p>Please fill in your details to support our cause.</p>
        <form action="/register" method="POST">
  <div class="flat">
    <div class="mb-3">
    <label  class="form-label" >Full Name</label>
    <input type="text" class="form-control" placeholder="John Doe" required name="fullname">
  </div>
  <div class="mb-3">
    <label for="exampleInputEmail1" class="form-label" required>Email address</label>
    <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="name@gmail.com" name="email" required>
  </div>
  </div>
  <div class="flat">
     <div class="mb-3">
    <label  class="form-label">Phone Number</label>
    <input type="tel" class="form-control" placeholder="123-456-7890" pattern="[0-9]{10}" name="phone" required>
  </div>
  <div class="mb-3">
  <label  class="form-label">Register as</label>
  <select class="form-select" id="Role" required name="role">
    <option value="donor">Donor</option>
    <option value="volunteer">Volunteer</option>
    
   
  </select>
</div>
  </div>
  
   <div class="flat">
     <div class="mb-3">
    <label  class="form-label">Password</label>
    <input type="text" class="form-control" placeholder="******" name="password" required>
  </div>
  <div class="mb-3">
  <label  class="form-label">Confirm Password</label>
  <input type="text" class="form-control" placeholder="******" name="confirmPassword" required>
  
</div>
  </div>

  <button type="submit" class="btn btn-primary" id="btn6">Register</button>
  
</form>
<div class="signUp">
    <p>Already have an account/</p>
  <a href="/login/form">login</a>
  </div>

    </div>
    </div>
     <div class="myContent">
        <div class="hero">
  <img 
    class="w-full h-auto object-contain" 
    src="https://lh3.googleusercontent.com/aida-public/AB6AXuAt-7dh1gf_rlPoTf4xL5BQ739YCJiSXtISygMO9kKRNhZSoBZ9F4Ddj6G-55H7nONP5YQUCBDfNn43feIvqm7_jJvfEQBMLd681a9oWIWxePVQqi6TvrlHXHc6vbyVOw80AWhYZXTb1e_DjFBdqN5XQkD0l3myZ-czahHNVIWjxEvd-FZIrRu8HV5Jk76-Nj0vYKViMdyMyJ7SUmBsM7L3kKhz29EPDSMp2cLkUHvtUxs0GpOJ99Jdvg" 
    alt="Volunteers distributing food and supplies"
  >
  </div>
    </div>
    </div>
    <div class="footer">
  <div class="contact">
    <h2>Helping Hands NGO</h2>
    <p>Dedicated to creating sustainable impact <br>
       through community empowerment and <br>
       focused social initiatives.</p>
  </div>

  <div class="contact">
    <p>Quick Links</p>
    <a href="#">About</a>
    <a href="#">Campaigns</a>
    <a href="#">Events</a>
    <a href="#">Contacts</a>
  </div>

  <div class="contact">
    <p>Support</p>
    <a href="#">Donate Now</a>
    <a href="#">Login</a>
    <a href="#">Privacy Policy</a>
    <a href="#">Contact us</a>
  </div>

  <div class="contact">
    <p>Contact us</p>
    <div class="pack">
      <i class="fa-regular fa-message"></i>
      <a href="#">info@helpinghandsngo.org</a>
    </div>
    <div class="pack">
      <i class="material-icons">call</i>
      <a href="#">+91 9231342131</a>
    </div>
    <div class="pack">
      <i class="material-icons">location_on</i>
      <a href="#">123 Social Ave, Community City, 400001</a>
    </div>
  </div>
</div>
