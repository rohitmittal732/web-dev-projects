<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Donations</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style3.css">
</head>
<body>

<nav class="Navbar">
    <h2>Helping Hands NGO</h2>

    <div class="pass">
        <a href="/donorDashboard">Dashboard</a>
        <a href="/mydonations">My Donations</a>
        <a href="/mycampaigns">Campaigns</a>
        <a href="/profile">Profile</a>
    </div>

    <div class="end">
        <i class="material-icons" onclick="window.location.href='/logout'">logout</i>
    </div>
</nav>

<div class="section">

    <div class="head">

        <div>
            <h2>My Donations</h2>
            <p>View all your donation history and contribution details.</p>
        </div>

        <a href='/donate/form' class="btn btn-primary" style="padding:10px 20px;color:white;">
            Donate Again
        </a>

    </div>

    <% if(donations.length > 0){ %>

    <div class="table-responsive mt-4">

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-primary">

                <tr>
                    <th>Campaign</th>
                    <th>Amount</th>
                    <th>Payment</th>
                    <th>Date</th>
                    <th>Message</th>
                </tr>

            </thead>

            <tbody>

                <% donations.forEach(donation=>{ %>

                <tr>

                    <td>
                        <%= donation.campaign %>
                    </td>

                    <td>
                        ₹<%= donation.amount %>
                    </td>

                    <td>
                        <span class="badge bg-success">
                            <%= donation.paymentMethod %>
                        </span>
                    </td>

                    <td>
                        <%= donation.createdAt.toLocaleDateString("en-IN") %>
                    </td>

                    <td>
                        <%= donation.message || "No Message" %>
                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

    <% } else { %>

    <div class="alert alert-info mt-4">

        <h5 class="mb-2">
            No Donations Found
        </h5>

        <p class="mb-3">
            You haven't made any donations yet.
        </p>

        <a href='/donate/form' class="btn btn-primary">
            Donate Now
        </a>

    </div>

    <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>