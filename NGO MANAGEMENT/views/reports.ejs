<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reports</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">NGO Management</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/volunteers">Volunteers</a></li>
          <li class="nav-item"><a class="nav-link" href="/donors">Donors</a></li>
          <li class="nav-item"><a class="nav-link" href="/campaigns">Campaigns</a></li>
          <li class="nav-item"><a class="nav-link" href="/donations">Donations</a></li>
          <li class="nav-item"><a class="nav-link" href="/reports">Reports</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <h2>Reports</h2>
    <p class="text-muted">Totals calculated from current arrays.</p>

    <div class="row mt-3">
      <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Total Volunteers</h5>
            <h3 class="mt-2"><%= volunteersCount %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Total Donors</h5>
            <h3 class="mt-2"><%= donorsCount %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Total Campaigns</h5>
            <h3 class="mt-2"><%= campaignsCount %></h3>
          </div>
        </div>
      </div>
      <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Total Donations Amount</h5>
            <h3 class="mt-2">$<%= totalDonationsAmount %></h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

